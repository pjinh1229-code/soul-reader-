{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soul-reader-billing",
  "account_id": "ee33db3044223ccec6ff9c0da863d2a5",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "soul-reader-a91f5",
    "PLAY_PACKAGE_NAME": "com.soulreader.soul_reader"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "soul-reader-billing",
    "database_id": "e510df4a-00f3-4d29-b689-c08cdb422caf",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": false }
  // Public account/database identifiers only. Runtime secrets are configured
  // in Cloudflare; no API token or private service-account key belongs here.
}
