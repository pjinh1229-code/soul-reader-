{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soul-reader-billing",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "soul-reader-a91f5",
    "PLAY_PACKAGE_NAME": "com.soulreader.soul_reader"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "soul-reader-billing",
    // Replace this example UUID with the database created in your own account.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": false }
  // Runtime secrets, set directly in the hosting provider, never in Git/chat:
  // GOOGLE_SERVICE_ACCOUNT_JSON, ACCOUNT_HMAC_KEY, TOKEN_ENCRYPTION_KEY.
  // The two keys must be independently generated 32-byte random keys, base64 encoded.
  // This example prepares code only. It creates no database and does not deploy.
}
